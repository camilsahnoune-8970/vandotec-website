---
import Layout from '../layouts/Layout.astro';
import ConnectGrid from '../components/ConnectGrid.astro';
import contactJson from '../data/contact.json';
import { loadPageData } from '../lib/loadPageData';

const contact = loadPageData(contactJson, {
  title: 'Contact | Vandotec',
  description: ''
});
---

<Layout title={contact.title} description={contact.description} path="/contact">

	<div class="form-success" id="formSuccess" role="status" hidden>
		<div class="container">
			<strong>Bedankt voor uw bericht.</strong> Wij nemen zo snel mogelijk contact met u op.
			Voor dringende defecten belt u direct <a href="tel:+3257335251">+32 57 33 52 51</a> (24/7).
		</div>
	</div>

	<script>
		(function(){
			// Statische build: ?sent=1 (van contact.php-redirect) wordt client-side getoond
			try {
				if(new URLSearchParams(window.location.search).get('sent') === '1'){
					var el = document.getElementById('formSuccess');
					if(el) el.hidden = false;
				}
			} catch(e) { /* geen melding zonder query-support */ }
			// Voorkom dubbele submits + toon voortgang (server antwoordt met redirect)
			var form = document.querySelector('.contact-form');
			var errBox = document.getElementById('formError');
			function setBtn(btn, busy){
				if(!btn) return;
				btn.disabled = busy;
				if(busy){ btn.setAttribute('aria-disabled', 'true'); btn.textContent = 'Bezig met verzenden…'; }
				else { btn.removeAttribute('aria-disabled'); btn.textContent = btn.getAttribute('data-label') || 'Verzenden'; }
			}
			if(form) form.addEventListener('submit', function(e){
				var btn = form.querySelector('button[type="submit"]');
				if(btn && !btn.getAttribute('data-label')) btn.setAttribute('data-label', btn.textContent);
				if(form.checkValidity && !form.checkValidity()){
					e.preventDefault();
					if(errBox) errBox.hidden = false;
					var bad = form.querySelector(':invalid');
					if(bad){
						bad.setAttribute('aria-invalid', 'true');
						if(bad.focus) bad.focus({ preventScroll: false });
					}
					return;
				}
				if(errBox) errBox.hidden = true;
				if(btn && btn.disabled) return;
				setBtn(btn, true);
			});
			// Herstelpad: terugkeer (redirect/bfcache) maakt de knop opnieuw bruikbaar
			window.addEventListener('pageshow', function(){
				var btn = document.querySelector('.contact-form button[type="submit"]');
				setBtn(btn, false);
			});
		})();
	</script>
	<section class="page-hero statement-hero">
		<div class="page-hero-photo" aria-hidden="true">
			<img src="/img/hero-contact.jpg" srcset="/img/hero-contact-800.jpg 800w, /img/hero-contact.jpg 1600w" sizes="100vw" alt="" fetchpriority="high" />
		</div>
		<div class="hero-mark" aria-hidden="true">HALLO</div>
		<div class="container">
			<div class="statement-grid">
				<div>
					<span class="eyebrow"><span class="eyebrow-index">06</span>Neem contact op</span>
					<h1>Een project? Laten we het <em>bouwen</em>.</h1>
				</div>
			</div>
			<p class="statement-line">Bel <a href="tel:+3257335251">+32 57 33 52 51</a> · Mail <a href="mailto:info@vandotec.be">info@vandotec.be</a></p>
		</div>
	</section>

	<section class="section" aria-label="Waarmee kunnen we u helpen">
		<div class="container">
			<div class="section-header">
				<h2 class="section-title">Kies uw onderwerp</h2>
			</div>
			<div class="subject-grid">
				<button class="subject-card" type="button" data-subject="offerte" aria-pressed="false">
					<img src="/img/exp-tankstations.jpg" alt="" loading="lazy" aria-hidden="true" />
					<span class="subject-label">Offerte aanvragen</span>
				</button>
				<button class="subject-card" type="button" data-subject="interventie" aria-pressed="false">
					<img src="/img/srv-interventie.jpg" alt="" loading="lazy" aria-hidden="true" />
					<span class="subject-label">Interventie / storing</span>
				</button>
				<button class="subject-card" type="button" data-subject="onderhoud" aria-pressed="false">
					<img src="/img/srv-preventief.jpg" alt="" loading="lazy" aria-hidden="true" />
					<span class="subject-label">Onderhoudscontract</span>
				</button>
			</div>
		</div>
	</section>

	<section class="section contact-dark" id="contactform">
		<div class="container">
			<div class="contact-grid">
				<div>
					<h2 class="section-title">{contact.form_title || 'Stuur een bericht'}</h2>
					<div class="content-block">
						{contact.form_note && <p set:html={contact.form_note} />}
					</div>
					<form class="contact-form" action="/contact.php" method="post">
						<p class="form-hint">Velden met * zijn verplicht.</p>
						<p class="form-error" id="formError" role="alert" hidden>Vul de verplichte velden in: naam, een geldig e-mailadres en uw bericht.</p>
						<div class="form-group">
							<label for="name">{contact.form_name_label || 'Naam'}{(contact.form_name_required ? ' *' : '')}</label>
							<input type="text" id="name" name="name" autocomplete="name" required={contact.form_name_required ? true : false} />
						</div>
						<div class="form-group">
							<label for="email">{contact.form_email_label || 'E-mail'}{(contact.form_email_required ? ' *' : '')}</label>
							<input type="email" id="email" name="email" autocomplete="email" required={contact.form_email_required ? true : false} />
						</div>
						<div class="form-group">
							<label for="phone">{contact.form_phone_label || 'Telefoon'}</label>
							<input type="tel" id="phone" name="phone" autocomplete="tel" />
						</div>
						<div class="form-group">
							<label for="subject">{contact.form_subject_label || 'Onderwerp'}</label>
							<select id="subject" name="subject">
								{(contact.form_subjects || contact.form_subject_options || []).map((option) => (
									<option value={option.value || option}>{option.label || option}</option>
								))}
							</select>
						</div>
						<div class="form-group">
							<label for="message">{contact.form_message_label || 'Bericht'}{(contact.form_message_required ? ' *' : '')}</label>
							<textarea id="message" name="message" rows="5" required={contact.form_message_required ? true : false}></textarea>
						<div style="display:none">
							<label for="website">Laat dit veld leeg</label>
							<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
						</div>
						</div>
						<button type="submit" class="btn btn-red">{contact.form_submit_label || 'Verzenden'}</button>
						<p class="form-fallback">Liever direct? Mail <a href={`mailto:${contact.email}`}>{contact.email}</a> of bel <a href="tel:+3257335251">+32 57 33 52 51</a>.</p>
					</form>
				</div>
				<aside class="contact-card" aria-label="Contactgegevens">
					<img src="/img/contact-werf.jpg" alt="Leidingwerk op een werf in opbouw" loading="lazy" width="1200" height="675" />
					<div class="contact-card-body">
						<h2>Contactgegevens</h2>
						<p>
							<strong>{contact.company || 'Vandotec'}</strong><br />
							<span set:html={(contact.address_lines || []).join('<br />')} />
						</p>
						<p>
							<strong>T</strong> <a href={`tel:${(contact.phone || '').replace(/\s/g, '')}`}>{contact.phone_display || contact.phone}</a>
						</p>
						<p>
							<strong>E</strong> <a href={`mailto:${contact.email}`}>{contact.email}</a>
						</p>
						{contact.vat && (
							<p class="btw">{contact.vat}</p>
						)}
					</div>
				</aside>
			</div>
		</div>
	</section>

	{/* FAQ opgesteld uit bestaande site-inhoud. */}
	<section class="section section-gray">
		<div class="container">
			<div class="section-header">
				<h2 class="section-title">Goed om te weten</h2>
			</div>
			<div class="faq">
				<details>
					<summary>Hoe snel komen jullie bij een defect?</summary>
					<p>Meteen. Meld het defect en wij plannen direct een interventie via onze 24/7 interventiedienst. Een eigen technicus komt ter plaatse.</p>
				</details>
				<details>
					<summary>Doen jullie ook preventief onderhoud?</summary>
					<p>Ja. Jaarlijkse controle met meetrapport, herstellingen en onderhoudscontracten met prioritaire interventie bij defecten.</p>
				</details>
				<details>
					<summary>Werken jullie met onderaannemers?</summary>
					<p>Nee. Eigen vaste ploegen met eigen materieel — van ontwerp tot oplevering en nazorg.</p>
				</details>
				<details>
					<summary>Welke installaties onderhouden jullie?</summary>
					<p>Tankstations, EV-laadinfrastructuur en infrastructuurwerken — van ontwerp en plaatsing tot onderhoud en herstelling.</p>
				</details>
				<details>
					<summary>Plaatsen jullie laadinfrastructuur voor bedrijven?</summary>
					<p>Ja. Van enkelvoudige snelladers tot volledige laadparken, met advies over netaansluiting en verbruik.</p>
				</details>
				<details>
					<summary>Hoe verloopt een offerte-aanvraag?</summary>
					<p>U stuurt uw project via dit formulier, e-mail of telefoon. Wij analyseren de situatie en u ontvangt een duidelijke offerte met uitvoeringsplan.</p>
				</details>
				<details>
					<summary>Hoe snel reageren jullie op een aanvraag?</summary>
					<p>Zo snel mogelijk. Voor defecten en storingen belt u best direct <a href="tel:+3257335251">+32 57 33 52 51</a> — die lijn is 24/7 bereikbaar.</p>
				</details>
				<details>
					<summary>IJken jullie brandstofpompen?</summary>
					<p>Ja. Wij ijken jaarlijks meer dan 3.500 vulpistolen in meer dan 500 dossiers — ISO 17020-geaccrediteerd als inspectieorganisme.</p>
				</details>
				<details>
					<summary>Waar is Vandotec gevestigd?</summary>
					<p>Nijverheidsstraat 49, 8970 Poperinge (Belgi&euml;).</p>
				</details>
			</div>
		</div>
	</section>

	{(contact.ctas || []).length > 0 && <ConnectGrid ctas={contact.ctas} />}

	<script>
		(function(){
			var cards = Array.prototype.slice.call(document.querySelectorAll('.subject-card'));
			var select = document.getElementById('subject');
			var form = document.getElementById('contactform');
			if(!cards.length || !select) return;
			cards.forEach(function(card){
				card.addEventListener('click', function(){
					select.value = card.getAttribute('data-subject') || '';
					cards.forEach(function(c){ c.setAttribute('aria-pressed', c === card ? 'true' : 'false'); });
					if(form){
						var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
						form.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
					}
				});
			});
		})();
	</script>
</Layout>
