---
import Layout from '../layouts/Layout.astro';
import contactJson from '../data/contact.json';
import { loadPageData } from '../lib/loadPageData';

const contact = loadPageData(contactJson, {
  title: 'Contact | Vandotec',
  description: ''
});
---

<Layout>
	<title>{contact.title}</title>
	<meta name="description" content={contact.description} />

	<section class="page-hero">
		<div class="container">
			<div class="hero-inner">
				<h1>Contact</h1>
				<p>Vraag een offerte aan, meld een interventie of stel uw vraag. Wij reageren binnen &eacute;&eacute;n werkdag.</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="content-grid">
				<div>
					<img src="/img/contact-site.svg" alt="" class="contact-illustration" aria-hidden="true" />
					<h2 class="section-title">Contactgegevens</h2>
					<div class="content-block">
						<p><strong>Vandotec</strong><br>Nijverheidsstraat 49<br>8970 Poperinge<br>Belgi&euml;</p>
						<p style="margin-top:1rem"><strong>T</strong> <a href="tel:+325****5251">+32 57 33 52 51</a></p>
						<p><strong>E</strong> <a href="mailto:info@vandotec.be">info@vandotec.be</a></p>
						<p class="btw" style="margin-top:1rem">BE 0417 923 411</p>
					</div>

					<h2 class="section-title" style="margin-top:2rem">24/7 interventie</h2>
					<div class="content-block">
						<p>Bij defecten en storingen bereikt u ons 24 uur per dag op <a href="tel:+325****5251">+32 57 33 52 51</a>. Een eigen technicus rijdt uit en lost het probleem ter plaatse op.</p>
					</div>
				</div>
				<div>
					<h2 class="section-title">Stuur een bericht</h2>
					<form class="contact-form" action="#" method="post">
						<div class="form-group">
							<label for="name">Naam *</label>
							<input type="text" id="name" name="name" required />
						</div>
						<div class="form-group">
							<label for="email">E-mail *</label>
							<input type="email" id="email" name="email" required />
						</div>
						<div class="form-group">
							<label for="phone">Telefoon</label>
							<input type="tel" id="phone" name="phone" />
						</div>
						<div class="form-group">
							<label for="subject">Onderwerp</label>
							<select id="subject" name="subject">
								<option value="">Kies een onderwerp</option>
								<option value="offerte">Offerte aanvragen</option>
								<option value="interventie">Interventie / storing</option>
								<option value="onderhoud">Onderhoudscontract</option>
								<option value="sollicitatie">Open sollicitatie</option>
								<option value="vraag">Algemene vraag</option>
							</select>
						</div>
						<div class="form-group">
							<label for="message">Bericht *</label>
							<textarea id="message" name="message" rows="5" required></textarea>
						</div>
						<button type="submit" class="btn btn-red">Verzenden</button>
					</form>
				</div>
			</div>
		</div>
	</section>

	<div class="stats-bar">
		<div class="container">
			<div class="stats-grid">
				<div>
					<div class="stat-number">40+</div>
					<div class="stat-label">Jaar ervaring</div>
				</div>
				<div>
					<div class="stat-number">100+</div>
					<div class="stat-label">Projecten per jaar</div>
				</div>
				<div>
					<div class="stat-number">24/7</div>
					<div class="stat-label">Interventiedienst</div>
				</div>
				<div>
					<div class="stat-number">10+</div>
					<div class="stat-label">Vaste medewerkers</div>
				</div>
			</div>
		</div>
	</div>

	<section class="connect-grid">
		<div class="connect-item navy">
			<h2>Interventie nodig?</h2>
			<p>Bel ons direct op <strong style="color:var(--white)">+32 57 33 52 51</strong>.</p>
			<a href="tel:+325****5251" class="btn btn-outline">Bel nu</a>
		</div>
		<div class="connect-item dark">
			<h2>Kom werken bij Vandotec</h2>
			<p>Bekijk onze openstaande vacatures of stuur een open sollicitatie.</p>
			<a href="/jobs" class="btn btn-outline">Vacatures</a>
		</div>
	</section>
</Layout>
