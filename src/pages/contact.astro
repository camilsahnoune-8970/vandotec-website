---
import Layout from '../layouts/Layout.astro';
import contactJson from '../data/contact.json';
import { loadPageData } from '../lib/loadPageData';

const contact = loadPageData(contactJson, {
  title: 'Contact | Vandotec',
  description: ''
});
---

<Layout>
	<title>{contact.title}</title>
	<meta name="description" content={contact.description} />

	<section class="page-hero">
		<div class="container">
			<div class="hero-inner">
				<h1>{contact.hero_title || 'Contact'}</h1>
				<p set:html={contact.hero_subtitle || ''} />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="content-grid">
				<div>
					<img src="/img/contact-site.svg" alt="" class="contact-illustration" aria-hidden="true" />
					<h2 class="section-title">Contactgegevens</h2>
					<div class="content-block">
						<p>
							<strong>{contact.company || 'Vandotec'}</strong><br />
							{(contact.address_lines || []).join('<br />')}<br />
							{contact.country || contact.address_country || ''}
						</p>
						<p style="margin-top:1rem">
							<strong>T</strong> <a href={`tel:${contact.phone}`}>{contact.phone_display || contact.phone}</a>
						</p>
						<p>
							<strong>E</strong> <a href={`mailto:${contact.email}`}>{contact.email}</a>
						</p>
						{contact.vat && (
							<p class="btw" style="margin-top:1rem">{contact.vat}</p>
						)}
					</div>

					{contact.intervention_title && (
						<>
							<h2 class="section-title" style="margin-top:2rem">{contact.intervention_title}</h2>
							<div class="content-block">
								<p set:html={contact.intervention_text || ''} />
							</div>
						</>
					)}
				</div>
				<div>
					<h2 class="section-title">{contact.form_title || 'Stuur een bericht'}</h2>
					<div class="content-block">
						{contact.form_note && <p set:html={contact.form_note} />}
					</div>
					<form class="contact-form" action="#" method="post">
						<div class="form-group">
							<label for="name">{contact.form_name_label || 'Naam'}{(contact.form_name_required ? ' *' : '')}</label>
							<input type="text" id="name" name="name" required={contact.form_name_required ? true : false} />
						</div>
						<div class="form-group">
							<label for="email">{contact.form_email_label || 'E-mail'}{(contact.form_email_required ? ' *' : '')}</label>
							<input type="email" id="email" name="email" required={contact.form_email_required ? true : false} />
						</div>
						<div class="form-group">
							<label for="phone">{contact.form_phone_label || 'Telefoon'}</label>
							<input type="tel" id="phone" name="phone" />
						</div>
						<div class="form-group">
							<label for="subject">{contact.form_subject_label || 'Onderwerp'}</label>
							<select id="subject" name="subject">
								{(contact.form_subjects || contact.form_subject_options || []).map((option) => (
									<option value={option.value || option}>{option.label || option}</option>
								))}
							</select>
						</div>
						<div class="form-group">
							<label for="message">{contact.form_message_label || 'Bericht'}{(contact.form_message_required ? ' *' : '')}</label>
							<textarea id="message" name="message" rows="5" required={contact.form_message_required ? true : false}></textarea>
						</div>
						<button type="submit" class="btn btn-red">{contact.form_submit_label || 'Verzenden'}</button>
					</form>
				</div>
			</div>
		</div>
	</section>

	{(contact.stats || []).length > 0 && (
		<div class="stats-bar">
			<div class="container">
				<div class="stats-grid">
					{contact.stats.map((stat) => (
						<div>
							<div class="stat-number" set:html={stat.number} />
							<div class="stat-label" set:html={stat.label} />
						</div>
					))}
				</div>
			</div>
		</div>
	)}

	{(contact.ctas || []).length > 0 && (
		<section class="connect-grid">
			{contact.ctas.map((cta) => (
				<div class={`connect-item ${cta.theme || 'navy'}`}>
					<h2 set:html={cta.text} />
					<p set:html={cta.description} />
					<a href={cta.url} class={`btn btn-${cta.theme === 'outline' ? 'outline' : 'red'}`}>{cta.label}</a>
				</div>
			))}
		</section>
	)}
</Layout>
