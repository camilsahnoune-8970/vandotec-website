---
import AdminLayout from '../../components/admin/AdminLayout.astro';

const pages = [
  { slug: 'home', title: 'Homepage', updated: '2026-07-30 16:00' },
  { slug: 'contact', title: 'Contact', updated: '2026-07-30 15:40' },
  { slug: 'expertises', title: 'Expertises', updated: '2026-07-30 15:20' },
  { slug: 'jobs', title: 'Jobs', updated: '2026-07-29 18:05' },
  { slug: 'over-vandotec', title: 'Over Vandotec', updated: '2026-07-29 09:10' },
  { slug: 'service-onderhoud', title: 'Service & Onderhoud', updated: '2026-07-28 21:35' }
];

const renderTableRows = pages.map((page) => `
  <tr>
    <td>
      <a href="/beheer/bewerk/${page.slug}" class="admin-table-title">${page.title}</a>
      <div class="admin-table-meta">${page.slug}</div>
    </td>
    <td>${page.updated}</td>
    <td>
      <a href="/beheer/bewerk/${page.slug}" class="admin-btn small">Bewerk</a>
    </td>
  </tr>
`).join('');
---

<AdminLayout title="Dashboard">
	<div class="admin-header">
		<div>
			<div class="admin-title">Dashboard</div>
			<div class="admin-subtitle">Pagina's en laatste bewerkingen.</div>
		</div>
		<div class="admin-header-actions">
			<a href="/" class="admin-btn secondary">Site openen</a>
		</div>
	</div>

	<div class="admin-card">
		<div class="admin-table-wrap">
			<table class="admin-table">
				<thead>
					<tr>
						<th>Pagina</th>
						<th>Laatst aangepast</th>
						<th>Actie</th>
					</tr>
				</thead>
				<tbody>
					${renderTableRows}
				</tbody>
			</table>
		</div>
	</div>
</AdminLayout>
