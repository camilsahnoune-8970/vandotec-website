---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { isAuthenticated } from '../../../lib/admin-auth';
import { readPageFile } from '../../../lib/admin-pages';
import type { APIContext } from 'astro';

export async function getStaticPaths() {
  return [
    { params: { slug: 'home' } },
    { params: { slug: 'contact' } },
    { params: { slug: 'expertises' } },
    { params: { slug: 'jobs' } },
    { params: { slug: 'over-vandotec' } },
    { params: { slug: 'service-onderhoud' } }
  ];
}

export async function GET({ params, cookies, redirect }: APIContext) {
  if (!isAuthenticated(cookies)) {
    return redirect('/beheer/login');
  }
  return new Response(null, { status: 204 });
}

const { slug } = Astro.params;
const raw = readPageFile(slug || 'home');
const data = JSON.parse(raw);
---

<AdminLayout title={`${data.title ?? slug} bewerken`} active={slug}>
  <div class="admin-header">
    <div>
      <div class="admin-title">{data.title ?? slug}</div>
      <div class="admin-subtitle">Bewerk content en zie direct de preview.</div>
    </div>
    <div class="admin-header-actions">
      <a href={`/${slug === 'home' ? '' : slug}`} target="_blank" rel="noreferrer" class="admin-btn secondary">Bekijk site</a>
      <button id="saveBtn" class="admin-btn">Opslaan</button>
    </div>
  </div>

  <div id="saveStatus" class="admin-save-status" role="status" aria-live="polite" hidden>Opgeslagen</div>
  <div id="saveError" class="admin-save-status admin-save-status--error" role="alert" aria-live="assertive" hidden></div>

  <form id="editorForm" method="POST" action="/api/save-page">
    <input type="hidden" name="slug" value="{slug}" />
    <div class="admin-grid">
      <div class="admin-card">
        <div class="admin-section-title">Content</div>
        <textarea id="jsonEditor" name="content" class="admin-textarea" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace; min-height: 70vh;">{raw.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</textarea>
      </div>
      <div class="admin-card">
        <div class="admin-section-title">Preview</div>
        <div class="admin-preview-frame">
          <iframe src="/{slug === 'home' ? '' : slug}" title="preview" sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe>
        </div>
      </div>
    </div>
  </form>
</AdminLayout>

<script>
  const form = document.getElementById('editorForm');
  const saveBtn = document.getElementById('saveBtn');
  const saveStatus = document.getElementById('saveStatus');
  const saveError = document.getElementById('saveError');
  const editor = document.getElementById('jsonEditor');

  function showStatus(message, isError = false) {
    if (!saveStatus || !saveError) return;
    saveStatus.hidden = true;
    saveError.hidden = true;
    saveStatus.textContent = '';
    saveError.textContent = '';

    if (!message) return;

    if (isError) {
      saveError.textContent = message;
      saveError.hidden = false;
    } else {
      saveStatus.textContent = message;
      saveStatus.hidden = false;
    }
  }

  function validateJson(text) {
    try {
      JSON.parse(text);
      return null;
    } catch (error) {
      return `JSON is ongeldig: ${error.message}`;
    }
  }

  if (editor) {
    editor.addEventListener('input', () => {
      const message = validateJson(editor.value);
      if (message) {
        showStatus(message, true);
        saveBtn.disabled = true;
      } else {
        showStatus('');
        saveBtn.disabled = false;
      }
    });
  }

  if (form && saveBtn) {
    saveBtn.addEventListener('click', async () => {
      const validationMessage = validateJson(editor?.value ?? '');
      if (validationMessage) {
        showStatus(validationMessage, true);
        return;
      }

      saveBtn.disabled = true;
      showStatus('Opslaan...');
      const formData = new FormData(form);
      const res = await fetch('/api/save-page', { method: 'POST', body: formData });
      const json = await res.json().catch(() => ({ ok: false, error: 'Onbekende fout bij opslaan.' }));
      if (json.ok) {
        showStatus('Opgeslagen');
        setTimeout(() => showStatus(''), 3000);
      } else {
        showStatus(json.error || 'Opslaan mislukt', true);
      }
      saveBtn.disabled = false;
    });
  }
</script>
