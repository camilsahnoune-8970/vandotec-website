---
import AdminLayout from '../../components/admin/AdminLayout.astro';

const PASSWORD = 'vandotec2026';
---

<AdminLayout title="Login" active="">
  <div class="admin-card" style="max-width: 420px; margin: 3rem auto;">
    <div class="admin-title" style="margin-bottom: 0.75rem;">Inloggen</div>
    <div class="admin-subtitle" style="margin-bottom: 1rem;">Beheerders toegang tot het CMS.</div>
    <form method="POST" action="/beheer">
      <div class="admin-field">
        <label class="admin-label" for="password">Wachtwoord</label>
        <input class="admin-input" type="password" id="password" name="password" autocomplete="current-password" required />
      </div>
      <input type="hidden" name="intent" value="login" />
      <button class="admin-btn" type="submit" style="width:100%;">Toegang</button>
    </form>
  </div>
</AdminLayout>
