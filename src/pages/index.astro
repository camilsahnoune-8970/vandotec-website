---
import Layout from '../layouts/Layout.astro';
import homeJson from '../data/home.json';
import { loadPageData } from '../lib/loadPageData';

const home = loadPageData(homeJson, {
  title: 'Vandotec',
  description: ''
});

const heroTitle = home.hero_title || 'Vandotec';
const heroIntro = home.hero_subtitle || '';
---

<Layout title={home.title} description={home.description} path="/">
	<link slot="head" rel="preload" as="image" imagesrcset="/img/mom-nacht-800.jpg 800w, /img/mom-nacht.jpg 1920w" imagesizes="100vw" fetchpriority="high" />

	<section class="hero">
		<div class="hero-photo" aria-hidden="true">
			<img src="/img/mom-nacht.jpg" srcset="/img/mom-nacht-800.jpg 800w, /img/mom-nacht.jpg 1920w" sizes="100vw" alt="" fetchpriority="high" />
		</div>
		<div class="hero-mark" aria-hidden="true">VANDOTEC</div>
		<div class="hero-frame" aria-hidden="true"></div>
		<span class="hero-corner" aria-hidden="true">EST. 1978 — POPERINGE</span>
				<div class="container">
					<div class="hero-inner">
						<span class="eyebrow"><span class="eyebrow-index">01</span>Installatiebedrijf sinds 1978</span>
						<h1 set:html={heroTitle} />
						<p class="lead">{heroIntro}</p>
						<div class="hero-cta">
							{(home.ctas || []).length > 0 && (
								<a href={home.ctas[0].url} class="btn btn-lg btn-red on-dark">{home.ctas[0].label}</a>
							)}
							{(home.ctas || []).length > 1 && (
								<a href={home.ctas[1].url} class="hero-link">{home.ctas[1].label} &rarr;</a>
							)}
						</div>
					</div>
				</div>
		<div class="container">
			<div class="hero-meta">
				<div class="hero-meta-item">
					<span class="hero-meta-index">01</span>
					<div class="hero-meta-num">24/7</div>
					<div class="hero-meta-label">Interventiedienst</div>
				</div>
				<div class="hero-meta-item">
					<span class="hero-meta-index">02</span>
					<div class="hero-meta-num">1978</div>
					<div class="hero-meta-label">Actief sinds</div>
				</div>
				<div class="hero-meta-item">
					<span class="hero-meta-index">03</span>
					<div class="hero-meta-num">0</div>
					<div class="hero-meta-label">Onderaannemers</div>
				</div>
			</div>
		</div>
	</section>

	<aside class="ticker" aria-label="Een greep uit onze klanten">
		<div class="ticker-track">
			<span>Maes — De Panne</span><span>Van Assche — Zulte</span><span>Spilmont — Hautrage</span><span>Galloo — Lumes</span><span>Tradit Energie — Deinze</span><span>Cools Avia — Brugge</span><span>Maes Brandstoffen — Merelbeke</span><span>Vanheede — Roeselare</span><span>Decospan — Menen</span><span>Cid Lines — Ieper</span><span>Demarol — Lessines</span><span>MIG Motors — Lievegem</span><span>Iveco Maenhout — Brugge</span><span>Pessleux — Fosses-la-Ville</span><span aria-hidden="true">Maes — De Panne</span><span aria-hidden="true">Van Assche — Zulte</span><span aria-hidden="true">Spilmont — Hautrage</span><span aria-hidden="true">Galloo — Lumes</span><span aria-hidden="true">Tradit Energie — Deinze</span><span aria-hidden="true">Cools Avia — Brugge</span><span aria-hidden="true">Maes Brandstoffen — Merelbeke</span><span aria-hidden="true">Vanheede — Roeselare</span><span aria-hidden="true">Decospan — Menen</span><span aria-hidden="true">Cid Lines — Ieper</span><span aria-hidden="true">Demarol — Lessines</span><span aria-hidden="true">MIG Motors — Lievegem</span><span aria-hidden="true">Iveco Maenhout — Brugge</span><span aria-hidden="true">Pessleux — Fosses-la-Ville</span>
		</div>
	</aside>

	{home.about_title && (
		<section class="section" id="about">
			<div class="container">
				<div class="content-grid ai-center">
					<div class="max-640">
						<h2 class="section-title">{home.about_title}</h2>
						{(home.about_paragraphs || []).map((paragraph) => (
							<p class="about-text" set:html={paragraph} />
						))}
						<a href="/over-vandotec" class="about-link">{home.about_link_label || 'Meer over ons'} &rarr;</a>
					</div>
					<div class="media-slot ratio-4x3">
						<img src="/img/home-about.jpg" alt="Tankstation met tankwagen en Vandotec-servicebus" loading="lazy" width="1200" height="900" />
					</div>
				</div>
			</div>
		</section>
	)}

	<section class="section" aria-label="Expertises">
		<div class="container">
			<div class="section-header max-820">
				<h2 class="section-title">Drie expertises, &eacute;&eacute;n aanspreekpunt</h2>
			</div>
			<div class="vtabs">
				<a href="/expertises#tankstations" class="vtab">
					<img src="/img/exp-tankstations.jpg" alt="" loading="lazy" aria-hidden="true" />
					<span class="vtab-label">Tankstations</span>
					<span class="vtab-body"><span class="vtab-text">Bouw en modernisering: grond- en leidingwerken, pompen, luifels en alle technische installaties.</span><span class="vtab-more">Bekijk &rarr;</span></span>
				</a>
				<a href="/expertises#ev-laadinstallaties" class="vtab">
					<img src="/img/exp-ev.jpg" alt="" loading="lazy" aria-hidden="true" />
					<span class="vtab-label">EV-laadinfrastructuur</span>
					<span class="vtab-body"><span class="vtab-text">Plaatsing en onderhoud van AC- en DC-laadpalen met bekabeling en laadbeheersystemen.</span><span class="vtab-more">Bekijk &rarr;</span></span>
				</a>
				<a href="/expertises#infrastructuurwerken" class="vtab">
					<img src="/img/exp-infrastructuur.jpg" alt="" loading="lazy" aria-hidden="true" />
					<span class="vtab-label">Infrastructuurwerken</span>
					<span class="vtab-body"><span class="vtab-text">Grondverzet, riolering, wegenis, betonwerken en HS/MS-installaties tot 36 kV.</span><span class="vtab-more">Bekijk &rarr;</span></span>
				</a>
			</div>
		</div>
	</section>

	{(home.stats || []).length > 0 && (
		<div class="stats-xl">
			<div class="container">
				{home.stats.map((stat) => (
					<div class="stats-xl-item">
						<div class="stats-xl-num" set:html={stat.number} />
						<div class="stats-xl-label" set:html={stat.label} />
					</div>
				))}
			</div>
		</div>
	)}

	<figure class="moment-band" aria-label="Tank in een sleuf met leidingwerk">
		<img src="/img/wrk-sleuf.jpg" alt="Tank in een sleuf met leidingwerk op een werf" loading="lazy" width="1000" height="1330" />
		<figcaption class="moment-caption"><div class="container"><strong>Van sleuf tot oplevering</strong><span>Uitvoering door eigen ploegen</span></div></figcaption>
	</figure>

	<section class="section" aria-label="Uitgelicht project">
		<div class="container">
			<div class="content-grid ai-center">
				<div class="media-slot ratio-4x3">
					<img src="/img/ref-maes-panne.jpg" alt="Tankstation Maes in de sneeuw" loading="lazy" width="1000" height="750" />
				</div>
				<div>
					<span class="eyebrow eyebrow-red">Uitgelicht project</span>
					<h2 class="section-title">Maes — De Panne</h2>
					<div class="content-block">
						<p>In De Panne realiseerde Vandotec het Maes-tankstation: een luifel met pompen, prijstoren en AdBlue-voorziening — uitgevoerd door eigen ploegen, zonder onderaannemers.</p>
					</div>
					<dl class="fact-list">
						<dt>Klant</dt><dd>Maes</dd>
						<dt>Plaats</dt><dd>De Panne</dd>
						<dt>Domein</dt><dd>Tankstations</dd>
					</dl>
					<p class="mt-15">
						<a href="/realisaties/maes-de-panne" class="btn btn-red">Bekijk project</a>
						&nbsp;&nbsp;<a href="/realisaties" class="about-link">Alle realisaties &rarr;</a>
					</p>
				</div>
			</div>
		</div>
	</section>

	{home.services_title && (home.services || []).length > 0 && (
		<section class="section section-dark">
			<div class="container">
				<div class="section-header text-center mx-auto">
					<span class="eyebrow">24/7 paraat</span>
					<h2 class="section-title centered light">{home.services_title}</h2>
					{home.services_subtitle && (
						<p class="section-sub light m-0-auto" set:html={home.services_subtitle} />
					)}
				</div>
			<div class="service-grid">
				{home.services.map((item, idx) => (
					<article class={`service-item${idx === 0 ? ' feature' : ''}`}>
						{item.img && (
							<a class="service-photo" href={`/service-onderhoud#${item.slug || ''}`} aria-hidden="true" tabindex="-1">
								<img src={item.img} alt="" loading="lazy" />
							</a>
						)}
						<div class="service-body">
							<div class="service-num" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</div>
							<h3>{item.title}</h3>
							<p set:html={item.text} />
							<a class="service-link" href={item.cta_url || `/service-onderhoud#${item.slug || ''}`}>{item.cta_label || 'Meer hierover'} &rarr;</a>
						</div>
					</article>
				))}
			</div>
			</div>
		</section>
	)}

	{home.process_title && (home.process_items || []).length > 0 && (
		<section class="section">
			<div class="container">
				<div class="process-split">
					<div class="process-sticky">
						<h2 class="section-title">{home.process_title}</h2>
						{home.process_subtitle && (
							<p class="section-sub" set:html={home.process_subtitle} />
						)}
						<p class="mt-15">
							<a href="/contact" class="btn btn-navy">Start uw project &rarr;</a>
						</p>
					</div>
					<div class="process-list">
						{home.process_items.map((item, idx) => (
							<div class="process-row">
								<div class="number" aria-hidden="true">{home.process_step_numbers?.[idx] ?? ''}</div>
								<div>
									<h3 set:html={item.title} />
									<p set:html={item.text} />
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>
	)}

	<figure class="moment-band" aria-label="Opgeleverd tankstation bij nacht">
		<img src="/img/mom-nacht.jpg" alt="Verlicht tankstation bij nacht" loading="lazy" width="1920" height="1080" />
		<figcaption class="moment-caption"><div class="container"><strong>Opgeleverd — ook bij nacht herkenbaar</strong><span>Pessleux — Fosses-la-Ville</span></div></figcaption>
	</figure>

	<section class="section statement-band" aria-label="Onze belofte">
		<div class="container promise-grid">
			<div>
				<span class="eyebrow eyebrow-red">Onze belofte</span>
				<p class="statement-big mt-125">Klein genoeg om snel te schakelen. En groots genoeg om uw <em>toekomst</em> te dragen.</p>
			</div>
			<aside class="promise-side">
				<p>Actief sinds 1978. Elk project in eigen beheer: eigen installatieteam, eigen serviceteam, 24/7 paraat.</p>
				<a class="promise-link" href="/over-vandotec">{home.about_link_label}</a>
			</aside>
		</div>
	</section>

	{(home.ctas || []).length > 0 && (
		<section class="connect-grid">
			{home.ctas.map((cta) => (
				<div class={`connect-item ${cta.theme === 'outline' ? 'dark' : 'navy'}`}>
					<h2 set:html={cta.text} />
					<p set:html={cta.description} />
					<a href={cta.url} class={`btn btn-${cta.theme === 'outline' ? 'outline' : 'red'}`}>{cta.label}</a>
				</div>
			))}
		</section>
	)}
</Layout>
