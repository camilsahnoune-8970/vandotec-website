---
import Layout from '../layouts/Layout.astro';
import homeJson from '../data/home.json';
import { loadPageData } from '../lib/loadPageData';

const home = loadPageData(homeJson, {
  title: 'Vandotec',
  description: ''
});

const heroTitle = home.hero_title || 'Vandotec';
const heroIntro = home.hero_subtitle || '';
---

<Layout>
	<title>{home.title}</title>
	<meta name="description" content={home.description} />
	<slot name="head" slot="head" />

	<section class="hero">
		<div class="hero-bg">
			<img src="/img/hero-bg.svg" alt="" aria-hidden="true" />
		</div>
		<div class="container">
			<div class="hero-inner">
				<h1>{heroTitle}</h1>
				<p>{heroIntro}</p>
				{(home.ctas || []).map((cta) => (
					<a href={cta.url} class={`btn btn-${cta.theme === 'outline' ? 'outline' : 'red'}`}>{cta.label}</a>
				))}
			</div>
		</div>
	</section>

	{home.about_title && (
		<section class="section" id="about">
			<div class="container">
				<div style="max-width:900px">
					<h2 class="section-title">{home.about_title}</h2>
					{(home.about_paragraphs || []).map((paragraph) => (
						<p class="about-text" set:html={paragraph} />
					))}
					<a href="/over-vandotec" class="about-link">{home.about_link_label || 'Meer over ons'} &rarr;</a>
				</div>
			</div>
		</section>
	)}

	{home.expertises_title && (home.expertises_sections || []).length > 0 && (
		<section class="section section-gray">
			<div class="container">
				<div class="section-header text-center">
					<h2 class="section-title centered">{home.expertises_title}</h2>
					{home.expertises_subtitle && (
						<p class="section-sub" style="margin:0 auto" set:html={home.expertises_subtitle} />
					)}
				</div>
				<div class="expertise-grid">
					{home.expertises_sections.map((section, idx) => (
						<a href={`/expertises#${section.slug}`} class="expertise-card">
							<img src={section.icon} alt="" class="card-icon" aria-hidden="true" />
							<h3>{section.title}</h3>
							<p set:html={section.summary} />
						</a>
					))}
				</div>
				{home.expertises_cta_label && (
					<p style="text-align:center;margin-top:2rem">
						<a href="/expertises" class="btn btn-navy">{home.expertises_cta_label} &rarr;</a>
					</p>
				)}
			</div>
		</section>
	)}

	{home.services_title && (home.services || []).length > 0 && (
		<section class="section section-dark">
			<div class="container">
				<div class="section-header text-center">
					<h2 class="section-title centered light">{home.services_title}</h2>
					{home.services_subtitle && (
						<p class="section-sub light" style="margin:0 auto" set:html={home.services_subtitle} />
					)}
				</div>
				<div class="service-grid">
					{home.services.map((item) => (
						<div class="service-item">
							<h3>{item.title}</h3>
							<p set:html={item.text} />
						</div>
					))}
				</div>
			</div>
		</section>
	)}

	{home.process_title && (home.process_items || []).length > 0 && (
		<section class="section">
			<div class="container">
				<div class="section-header text-center">
					<h2 class="section-title centered">{home.process_title}</h2>
					{home.process_subtitle && (
						<p class="section-sub" style="margin:0 auto" set:html={home.process_subtitle} />
					)}
				</div>
				<div class="steps-grid">
					{home.process_items.map((item, idx) => (
						<div class="step-card">
							<div class="number">{home.process_step_numbers?.[idx] ?? ''}</div>
							<h3 set:html={item.title} />
							<p set:html={item.text} />
						</div>
					))}
				</div>
			</div>
		</section>
	)}

	{(home.stats || []).length > 0 && (
		<div class="stats-bar">
			<div class="container">
				<div class="stats-grid">
					{home.stats.map((stat) => (
						<div>
							<div class="stat-number" set:html={stat.number} />
							<div class="stat-label" set:html={stat.label} />
						</div>
					))}
				</div>
			</div>
		</div>
	)}

	{(home.ctas || []).length > 0 && (
		<section class="connect-grid">
			{home.ctas.map((cta) => (
				<div class={`connect-item ${cta.theme || 'navy'}`}>
					<h2 set:html={cta.text} />
					<p set:html={cta.description} />
					<a href={cta.url} class={`btn btn-${cta.theme === 'outline' ? 'outline' : 'red'}`}>{cta.label}</a>
				</div>
			))}
		</section>
	)}
</Layout>
