---
import Layout from '../layouts/Layout.astro';
import overJson from '../data/over-vandotec.json';
import { loadPageData } from '../lib/loadPageData';

const over = loadPageData(overJson, {
  title: 'Over Vandotec | Vandotec',
  description: ''
});
---

<Layout>
	<title>{over.title}</title>
	<meta name="description" content={over.description} />

	<section class="page-hero">
		<div class="container">
			<div class="hero-inner">
				<h1>Over Vandotec</h1>
				<p>Meer dan 40 jaar ervaring in tankstation installaties, EV laadinfrastructuur, carwashes, reinigingssystemen, infrastructuurwerken en waterprojecten.</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2 class="section-title">Familiebedrijf met vakkennis</h2>
					<div class="content-block">
						<p>Vandotec is een Belgisch familiebedrijf uit Poperinge, opgericht in 1984. Wat begon met tankstation installaties groeide uit tot een gespecialiseerd installatiebedrijf in zes domeinen: tankstations, EV-laadinfrastructuur, carwashes, industri&euml;le reiniging, infrastructuurwerken en waterprojecten.</p>
						<p>Wij werken uitsluitend met eigen vaste ploegen en eigen materieel. Geen onderaannemers. Dat betekent korte lijnen, vaste contactpersonen en een constante kwaliteit van ontwerp tot oplevering.</p>
						<p>Onze klanten zijn tankstationuitbaters, transportbedrijven, industri&euml;le ondernemingen, landbouwbedrijven en overheden in Vlaanderen en aangrenzend Frankrijk.</p>
					</div>
				</div>
				<div>
					<img src="/img/team-workshop.svg" alt="" class="about-illustration" aria-hidden="true" />
					<div class="content-block card-outline" style="margin-top:1.5rem">
						<h3>Kerncijfers</h3>
						<ul class="list-check">
							<li>Opgericht in 1984</li>
							<li>40+ jaar ervaring</li>
							<li>10+ vaste medewerkers</li>
							<li>Eigen technische dienst</li>
							<li>24/7 interventiedienst</li>
							<li>Eigen gespecialiseerd materieel</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section section-gray">
		<div class="container">
			<h2 class="section-title" style="text-align:center;margin-bottom:2rem">Onze waarden</h2>
			<div class="values-grid">
				<div class="value-item">
					<h3>Vakmanschap</h3>
					<p>Wij voeren elk project uit met eigen vaste ploegen en eigen materieel. Onze technici kennen de installaties door en door, van ontwerp tot oplevering.</p>
				</div>
				<div class="value-item">
					<h3>Service</h3>
					<p>24/7 interventiedienst, eigen stock onderdelen en een vaste contactpersoon per project. Bij een defect staan wij paraat.</p>
				</div>
				<div class="value-item">
					<h3>Breed inzetbaar</h3>
					<p>Zes domeinen onder &eacute;&eacute;n dak: van tankstation tot waterproject. Kleine herstellingen en totaalprojecten, wij voeren uit.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2 class="section-title">Projectaanpak</h2>
					<div class="content-block">
						<p>Elk project doorloopt bij Vandotec vijf vaste stappen. Van uw eerste vraag tot oplevering en nazorg: u weet waar u aan toe bent, wij weten wat wij doen.</p>
					</div>
					<div class="steps">
						<div class="step">
							<div class="step-num">1</div>
							<div>
								<h3>Analyse &amp; advies</h3>
								<p>We brengen uw situatie, locatie en technische vereisten in kaart en adviseren over de beste oplossing.</p>
							</div>
						</div>
						<div class="step">
							<div class="step-num">2</div>
							<div>
								<h3>Ontwerp &amp; offerte</h3>
								<p>Onze technische dienst werkt een uitvoeringsplan uit en u ontvangt een duidelijke offerte.</p>
							</div>
						</div>
						<div class="step">
							<div class="step-num">3</div>
							<div>
								<h3>Realisatie</h3>
								<p>Eigen ploegen voeren het project uit, met oog voor veiligheid en minimale hinder.</p>
							</div>
						</div>
						<div class="step">
							<div class="step-num">4</div>
							<div>
								<h3>Oplevering</h3>
								<p>Na testen en documentatie leveren we het project op en lichten we de installatie samen met de gebruiker door.</p>
							</div>
						</div>
						<div class="step">
							<div class="step-num">5</div>
							<div>
								<h3>Nazorg</h3>
								<p>Optioneel onderhoudscontract met jaarlijkse controle, meetrapport en prioritair interventie bij defecten.</p>
							</div>
						</div>
					</div>
				</div>
				<div>
					<div class="content-block card-outline">
						<h3>Een project?</h3>
						<p>Neem contact met ons op voor een offerte op maat of advies.</p>
						<a href="/contact" class="btn btn-red" style="margin-top:1rem">Offerte aanvragen</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<div class="stats-bar">
		<div class="container">
			<div class="stats-grid">
				<div>
					<div class="stat-number">40+</div>
					<div class="stat-label">Jaar ervaring</div>
				</div>
				<div>
					<div class="stat-number">100+</div>
					<div class="stat-label">Projecten per jaar</div>
				</div>
				<div>
					<div class="stat-number">24/7</div>
					<div class="stat-label">Interventiedienst</div>
				</div>
				<div>
					<div class="stat-number">10+</div>
					<div class="stat-label">Vaste medewerkers</div>
				</div>
			</div>
		</div>
	</div>

	<section class="connect-grid">
		<div class="connect-item navy">
			<h2>Een project?</h2>
			<p>Vraag een offerte aan voor uw tankstation, laadinfra, carwash, reiniging, infra- of waterproject.</p>
			<a href="/contact" class="btn btn-red">Offerte aanvragen</a>
		</div>
		<div class="connect-item dark">
			<h2>24/7 interventie nodig?</h2>
			<p>Bij defecten plannen wij direct een interventie. Bel ons op <strong style="color:var(--white)">+32 57 33 52 51</strong>.</p>
			<a href="tel:+3257335251" class="btn btn-outline">Bel nu</a>
		</div>
	</section>
</Layout>
