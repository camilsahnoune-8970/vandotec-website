---
import Layout from '../layouts/Layout.astro';
import jobsJson from '../data/jobs.json';
import { loadPageData } from '../lib/loadPageData';

const jobs = loadPageData(jobsJson, {
  title: 'Jobs | Vandotec',
  description: ''
});
---

<Layout title={jobs.title} description={jobs.description} path="/jobs">

	<section class="page-hero">
		<div class="page-hero-photo" aria-hidden="true">
			<img src="/img/jobs-team.jpg" srcset="/img/jobs-team-800.jpg 800w, /img/jobs-team.jpg 1200w" sizes="100vw" alt="" fetchpriority="high" />
		</div>
		<div class="hero-mark" aria-hidden="true">TEAM</div>
		<div class="container">
			<div class="hero-inner">
				<span class="eyebrow"><span class="eyebrow-index">05</span>Kom bij het team</span>
				<h1 set:html={jobs.hero_title || 'Jobs'} />
				<p set:html={jobs.hero_subtitle || ''} />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2 class="section-title">{jobs.why_title || 'Waarom bij Vandotec werken?'}</h2>
					<div class="content-block">
						{(jobs.why_paragraphs || []).map((paragraph) => (
							<p set:html={paragraph} />
						))}
					</div>
				</div>
				<div>
					<div class="content-block card-outline">
						<h3>{jobs.benefits_title || 'Wat wij bieden'}</h3>
						<ul class="list-check">
							{(jobs.benefits || []).map((item) => (
								<li set:html={item} />
							))}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<figure class="moment-band" aria-label="Collega's geven elkaar een high-five op kantoor">
		<img src="/img/jobs-waarden.jpg" srcset="/img/jobs-waarden-800.jpg 800w, /img/jobs-waarden.jpg 1600w" sizes="100vw" alt="Collega's geven elkaar een high-five op kantoor" loading="lazy" width="1600" height="900" />
		<figcaption class="moment-caption"><div class="container"><strong>Collega's onder elkaar</strong><span>Werken bij Vandotec</span></div></figcaption>
	</figure>

	<section class="section section-gray">
		<div class="container">
			<h2 class="section-title">{jobs.open_roles_title || 'Openstaande vacatures'}</h2>
			<p style="margin-bottom:2rem;max-width:600px" set:html={jobs.open_roles_text || ''} />
			{jobs.open_roles_cta_label && (
				<p style="margin-top:1rem">
					<a href="/contact" class="btn btn-red">{jobs.open_roles_cta_label}</a>
				</p>
			)}
		</div>
	</section>

	{(jobs.ctas || []).length > 0 && (
		<section class="connect-grid">
			{jobs.ctas.map((cta) => (
				<div class={`connect-item ${cta.theme === 'outline' ? 'dark' : 'navy'}`}>
					<h2 set:html={cta.text} />
					<p set:html={cta.description} />
					<a href={cta.url} class={`btn btn-${cta.theme === 'outline' ? 'outline' : 'red'}`}>{cta.label}</a>
				</div>
			))}
		</section>
	)}
</Layout>
