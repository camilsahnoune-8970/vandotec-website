---
export const siteName = 'Vandotec';
export const siteDescription = 'Vandotec installeert en onderhoudt tankstationinstallaties, EV-laadinfrastructuur, carwashes, reinigingssystemen, infrastructuurwerken en waterprojecten. Meer dan 40 jaar ervaring in installatie en 24/7 onderhoud.';
---

<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#091950" />
		<meta name="msapplication-TileColor" content="#091950" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="/style.css" />
		<meta property="og:image" content="https://www.vandotec.be/logo-white.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://www.vandotec.be" />
		<meta property="og:title" content={siteName} />
		<meta property="og:description" content={siteDescription} />
		<meta name="twitter:card" content="summary_large_image" />
		<slot name="head" />
	</head>
	<body>
		<header class="header">
			<div class="container">
				<div class="header-inner">
					<a href="/" class="header-logo" aria-label={siteName}>
						<img src="/logo.svg" alt={siteName} class="header-logo-img" />
					</a>
					<div class="header-right">
						<nav class="header-nav" aria-label="Hoofdnavigatie">
							<a href="/" class:list={[{ active: Astro.url.pathname === '/' }]}>Home</a>
							<a href="/expertises" class:list={[{ active: Astro.url.pathname === '/expertises' }]}>Expertises</a>
							<a href="/service-onderhoud" class:list={[{ active: Astro.url.pathname === '/service-onderhoud' }]}>Service & onderhoud</a>
							<a href="/over-vandotec" class:list={[{ active: Astro.url.pathname === '/over-vandotec' }]}>Over Vandotec</a>
							<a href="/jobs" class:list={[{ active: Astro.url.pathname === '/jobs' }]}>Jobs</a>
							<a href="/contact" class:list={[{ active: Astro.url.pathname === '/contact' }]}>Contact</a>
						</nav>
						<div class="header-lang">
							<a href="#" class="active">NL</a>
							<span style="color:var(--border)">|</span>
							<a href="#">FR</a>
						</div>
						<div class="header-cta">
							<a href="/contact" class="btn btn-red">Offerte aanvragen</a>
						</div>
						<button class="header-mobile-toggle" id="mobileToggle" aria-label="Menu openen">
							<span></span><span></span><span></span>
						</button>
					</div>
				</div>
			</div>
		</header>

		<div class="mobile-nav" id="mobileNav">
			<a href="/">Home</a>
			<a href="/expertises">Expertises</a>
			<a href="/service-onderhoud">Service & onderhoud</a>
			<a href="/over-vandotec">Over Vandotec</a>
			<a href="/jobs">Jobs</a>
			<a href="/contact">Contact</a>
			<a href="/contact" class="btn btn-red" style="margin-top:1rem;text-align:center">Offerte aanvragen</a>
			<div class="mobile-lang">
				<a href="#" class="active">NL</a>
				<a href="#">FR</a>
			</div>
		</div>

		<slot />

		<footer class="footer">
			<div class="footer-main">
				<div class="container">
					<div class="footer-grid">
						<div class="footer-brand">
							<img src="/logo.svg" alt={siteName} class="footer-logo-img" />
							<p>{siteName} installeert en onderhoudt tankstation installaties, EV laadinstallaties, carwashes, reinigingssystemen, infrastructuurwerken en waterprojecten.</p>
							<p class="btw">BE 0417 923 411</p>
						</div>
						<div class="footer-col">
							<h4>Expertises</h4>
							<ul>
								<li><a href="/expertises#tankstations">Tankstations</a></li>
								<li><a href="/expertises#ev-laadinstallaties">EV laadinstallaties</a></li>
								<li><a href="/expertises#carwashes">Carwashes</a></li>
								<li><a href="/expertises#reinigingssystemen">Reinigingssystemen</a></li>
								<li><a href="/expertises#infrastructuurwerken">Infrastructuurwerken</a></li>
								<li><a href="/expertises#waterprojecten">Waterprojecten</a></li>
							</ul>
						</div>
						<div class="footer-col">
							<h4>Services</h4>
							<ul>
								<li><a href="/service-onderhoud#interventie">24/7 interventiedienst</a></li>
								<li><a href="/service-onderhoud#onderhoud">Onderhoud &amp; herstellingen</a></li>
								<li><a href="/service-onderhoud#preventief">Preventief onderhoud</a></li>
								<li><a href="/service-onderhoud#tank-cleaning">Tank cleaning</a></li>
								<li><a href="/expertises">Totaalprojecten</a></li>
							</ul>
						</div>
						<div class="footer-col">
							<h4>Contact</h4>
							<div class="footer-contact">
								<p><strong>{siteName}</strong><br>Nijverheidsstraat 49<br>8970 Poperinge<br>Belgi&euml;</p>
								<p style="margin-top:.75rem"><a href="tel:+3257335251">+32 57 33 52 51</a></p>
								<p><a href="mailto:info@vandotec.be">info@vandotec.be</a></p>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="footer-bottom">
				<div class="container">
					<div class="footer-bottom-inner">
						<span class="copy">&copy; 2026 {siteName}</span>
						<nav class="nav">
												<a href="/disclaimer">Disclaimer</a>
												<a href="/privacy">Privacyverklaring</a>
												<a href="/cookies">Cookieverklaring</a>
												<a href="/algemenevoorwaarden">Algemene voorwaarden</a>
											</nav>
					</div>
				</div>
			</div>
		</footer>
	<div class="cookie-bar" id="cookieBar" aria-live="polite">
		<div class="container">
			<p>Deze website gebruikt functionele cookies. Geen tracking, geen targeting. <a href="/cookies">Lees meer</a></p>
			<button id="acceptCookies" class="btn btn-red" type="button">Accepteren</button>
		</div>
	</div>


		<script>
			(function(){
				var toggle = document.getElementById('mobileToggle');
				var nav = document.getElementById('mobileNav');
				if(toggle && nav){
					toggle.addEventListener('click', function(){
						nav.classList.toggle('open');
					});
					nav.querySelectorAll('a').forEach(function(link){
						link.addEventListener('click', function(){
							nav.classList.remove('open');
						});
					});
					document.addEventListener('click', function(e){
						if(nav.classList.contains('open') && !nav.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)){
							nav.classList.remove('open');
						}
					});
				}
			})();
	
		// cookie consent
		(function(){
			var bar = document.getElementById('cookieBar');
			if(!bar) return;
			if(localStorage.getItem('vdtc-cookies') === 'accepted') return;
			bar.classList.add('show');
			var btn = document.getElementById('acceptCookies');
			if(btn) btn.addEventListener('click', function(){
				localStorage.setItem('vdtc-cookies', 'accepted');
				bar.classList.remove('show');
			});
		})();
	</script>
	</body>
</html>
