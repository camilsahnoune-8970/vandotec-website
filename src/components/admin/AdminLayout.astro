---
interface Props {
	title?: string;
	active?: string;
}

const { title = 'Vandotec Admin', active = '' } = Astro.props;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<link rel="stylesheet" href="/style.css" />
		<link rel="stylesheet" href="/admin.css" />
		<slot name="head" />
	</head>
	<body>
		<div class="admin-layout">
			<aside class="admin-sidebar">
				<div class="admin-brand">Vandotec</div>
				<nav class="admin-nav">
					<a href="/beheer" data-nav-path="/beheer" class="admin-nav-item">Dashboard</a>
					<a href="/beheer/bewerk/home" data-nav-path="/beheer/bewerk/home" class="admin-nav-item">Homepage</a>
					<a href="/beheer/bewerk/contact" data-nav-path="/beheer/bewerk/contact" class="admin-nav-item">Contact</a>
					<a href="/beheer/bewerk/expertises" data-nav-path="/beheer/bewerk/expertises" class="admin-nav-item">Expertises</a>
					<a href="/beheer/bewerk/jobs" data-nav-path="/beheer/bewerk/jobs" class="admin-nav-item">Jobs</a>
					<a href="/beheer/bewerk/over-vandotec" data-nav-path="/beheer/bewerk/over-vandotec" class="admin-nav-item">Over Vandotec</a>
					<a href="/beheer/bewerk/service-onderhoud" data-nav-path="/beheer/bewerk/service-onderhoud" class="admin-nav-item">Service & Onderhoud</a>
				</nav>
				<div class="admin-sidebar-footer">
					<form method="POST" action="/beheer" class="admin-logout-form">
						<input type="hidden" name="intent" value="logout" />
						<button class="admin-btn secondary" type="submit">Uitloggen</button>
					</form>
					<a href="/" class="admin-btn secondary">Naar site</a>
				</div>
			</aside>
			<main class="admin-main">
				<header class="admin-topbar">
					<div>
						<div class="admin-title">{title}</div>
					</div>
					<div class="admin-topbar-actions">
						<a href="/" class="admin-btn secondary">Site openen</a>
					</div>
				</header>
				<slot />
			</main>
		</div>
		<script is:inline>
		  (function () {
		    var current = window.location.pathname || '';
		    var items = document.querySelectorAll('.admin-nav-item[data-nav-path]');
		    for (var i = 0; i < items.length; i++) {
		      items[i].classList.toggle('active', items[i].getAttribute('data-nav-path') === current);
		    }
		  })();
		</script>
	</body>
</html>
