---
interface Props {
	title?: string;
	active?: string;
}

const { title = 'Vandotec Admin', active = '' } = Astro.props;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<link rel="stylesheet" href="/style.css" />
		<link rel="stylesheet" href="/admin.css" />
		<slot name="head" />
	</head>
	<body>
		<div class="admin-layout">
			<aside class="admin-sidebar">
				<div class="admin-brand">Vandotec</div>
				<nav class="admin-nav">
					<a href="/beheer" class="admin-nav-item {active === 'dashboard' ? 'active' : ''}">Dashboard</a>
					<a href="/beheer/bewerk/home" class="admin-nav-item {active === 'home' ? 'active' : ''}">Homepage</a>
					<a href="/beheer/bewerk/contact" class="admin-nav-item {active === 'contact' ? 'active' : ''}">Contact</a>
					<a href="/beheer/bewerk/expertises" class="admin-nav-item {active === 'expertises' ? 'active' : ''}">Expertises</a>
					<a href="/beheer/bewerk/jobs" class="admin-nav-item {active === 'jobs' ? 'active' : ''}">Jobs</a>
					<a href="/beheer/bewerk/over-vandotec" class="admin-nav-item {active === 'over-vandotec' ? 'active' : ''}">Over Vandotec</a>
					<a href="/beheer/bewerk/service-onderhoud" class="admin-nav-item {active === 'service-onderhoud' ? 'active' : ''}">Service & Onderhoud</a>
				</nav>
				<div class="admin-sidebar-footer">
					<form method="POST" action="/beheer" class="admin-logout-form">
						<input type="hidden" name="intent" value="logout" />
						<button class="admin-btn secondary" type="submit">Uitloggen</button>
					</form>
					<a href="/" class="admin-btn secondary">Naar site</a>
				</div>
			</aside>
			<main class="admin-main">
				<header class="admin-topbar">
					<div>
						<div class="admin-title">{title}</div>
					</div>
					<div class="admin-topbar-actions">
						<a href="/" class="admin-btn secondary">Site openen</a>
					</div>
				</header>
				<slot />
			</main>
		</div>
	</body>
</html>
